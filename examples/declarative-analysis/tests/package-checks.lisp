(in-package :clds-example)

(defun run-package-checks ()
  "Run the existing isolated domain suite and ordinary-REPL integration checks."
  (uiop:run-program
   (append (list *planner-python*
         (namestring (asdf:system-relative-pathname "declarative-analysis" "run-grammar.py"))
         "--check" "--wouldwork" (namestring (pathname *wouldwork-source*))
         "--sbcl" *planner-sbcl*) (worker-dependency-arguments))
   :output t :error-output :output)
  (let* ((object (demo))
         (package-before *package*)
         (wouldwork-before (find-package :wouldwork))
         (problem (merge-pathnames "src/problem.lisp" *wouldwork-source*))
         (values-file (merge-pathnames "vals.lisp" *wouldwork-source*))
         (files (list problem values-file))
         (contents (mapcar (lambda (path) (when (probe-file path) (uiop:read-file-string path))) files)))
    (assert (null (proposals object)))
    (assert (not (eq object (demo))))
    (propose object :analysis)
    (assert (eq package-before *package*))
    (assert (eq wouldwork-before (find-package :wouldwork)))
    (assert (= 2 (length (proposals object))))
    (assert (= 3 (getf (current-check object) :independent-cases)))
    (assert (every (lambda (p) (eq :conditional-on-obligations (getf p :status)))
                   (proposals object)))
    (assert (every (lambda (p) (= (revision object) (getf p :revision))) (proposals object)))
    (loop for path in files for content in contents
          do (assert (equal content (when (probe-file path) (uiop:read-file-string path)))))
    (format t "~&PASS: Ordinary REPL proposals preserve caller package and Wouldwork files~%")
    (approve object :analysis-plan :proposal :paired-t :by :package-test)
    (let ((before (history object)) (old-proposals (proposals object))
          (old-check (snapshot (current-check object)))
          (old-approvals (approvals object)) (old-generation (generation object))
          (*wouldwork-source* #p"/nonexistent/clds-test-wouldwork/"))
      (assert (handler-case (progn (propose object :analysis) nil) (error () t)))
      (assert (equal before (history object)))
      (assert (equalp old-proposals (proposals object)))
      (assert (equalp old-check (current-check object)))
      (assert (equalp old-approvals (approvals object)))
      (assert (= old-generation (generation object))))
    (format t "PASS: Unavailable planner preserves previous proposals and selections~%")
    (configure object (goal :confidence-level 0.90d0))
    (assert (null (proposals object)))
    (assert (eq :stale (getf (first (approvals object)) :status)))
    (propose object :analysis)
    (assert (every (lambda (p) (= 0.90d0 (getf (getf p :goal-contract) :confidence-level)))
                   (proposals object)))
    (format t "PASS: Worker round-trip preserves revision and changed confidence contract~%"))
  (let ((object (demo :fixture :independent-cultures)))
    (propose object :analysis)
    (assert (equal '(:welch) (mapcar (lambda (p) (getf p :id)) (proposals object))))
    (format t "PASS: Independent fixture works through public package entry point~%"))
  (uiop:with-temporary-file (:pathname path :prefix "clds-invalid-" :type "sexp")
    (with-open-file (out path :direction :output :if-exists :supersede)
      (write-string "#.(error \"Reader evaluation must remain disabled\")" out))
    (assert (handler-case (progn (read-message path) nil) (error () t))))
  (format t "PASS: Worker data transport rejects reader evaluation~%")
  (format t "~&29 grammar/backend checks and 5 package integration checks passed.~%")
  t)
