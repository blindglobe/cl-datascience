(in-package :clds-example)

(defun snapshot (value)
  "Copy mutable configuration values and source arrays across API boundaries."
  (typecase value
    (cons (cons (snapshot (car value)) (snapshot (cdr value))))
    (string (copy-seq value))
    (array (let ((copy (make-array (array-dimensions value))))
             (dotimes (i (array-total-size value) copy)
               (setf (row-major-aref copy i) (snapshot (row-major-aref value i))))))
    (t value)))

(defclass dataset ()
  ((table :initarg :table :reader %table)
   (columns :initarg :columns :reader columns)
   (variables :initarg :variables :reader variables)
   (row-labels :initarg :row-labels :reader row-labels)
   (metadata :initarg :metadata :reader source-metadata)))

(defun dataset (table &key columns variables row-labels metadata)
  "Construct cases-by-variables source storage without declaring rows independent."
  (unless (and (arrayp table) (= 2 (array-rank table))
               (= (length columns) (array-dimension table 1))
               (= (length columns) (length (remove-duplicates columns :test #'equal))))
    (error "Expected a rank-two array with distinct column labels."))
  (when row-labels
    (unless (= (length row-labels) (array-dimension table 0))
      (error "Row labels must match measurement records.")))
  (make-instance 'dataset :table (snapshot table) :columns (snapshot columns)
                 :variables (snapshot variables) :row-labels (snapshot row-labels)
                 :metadata (snapshot metadata)))

(defun dataset-table (data) (snapshot (%table data)))

(defclass study ()
  ((name :initarg :name :reader study-name)
   (data :initarg :data :reader study-data)
   (aspects :initform nil :accessor aspects)
   (revision :initform 0 :accessor %revision)
   (check :initform nil :accessor current-check)
   (proposals :initform nil :accessor %proposals)
   (generation :initform 0 :accessor generation)
   (approvals :initform nil :accessor %approvals)
   (history :initform nil :accessor %history)))

(defclass aspect ()
  ((name :initarg :name :reader aspect-name)
   (fields :initarg :fields :reader aspect-fields)))

(defparameter *aspect-schema*
  '((:goal (:quantity :contrast :claim :confidence-level)
           (:quantity :contrast :claim))
    (:design (:structure :independent-unit :assignment-unit :paired-by :replicates-within)
             (:structure :independent-unit :assignment-unit))
    (:measurements (:outcome :group :statistical-type :units :aggregation)
                   (:outcome :group :statistical-type :units))
    (:assumptions (:independent-cases :normal-differences :normal-groups :source)
                  (:independent-cases))))

(defun make-aspect (name fields)
  (setf fields (snapshot fields))
  (let ((schema (assoc name *aspect-schema*)))
    (unless (and schema (listp fields) (evenp (length fields)))
      (error "Unknown aspect or malformed fields: ~S" name))
    (loop for (key value) on fields by #'cddr
          do (unless (member key (second schema))
               (error "Unknown ~S field ~S." name key))
             (when (eq key :confidence-level)
               (unless (and (realp value) (< 0 value 1))
                 (error "Confidence level must lie strictly between zero and one.")))
             (when (and value (member key '(:independent-unit :assignment-unit :paired-by
                                            :replicates-within :outcome :group)))
               (unless (typep value '(or symbol string))
                 (error "Column references must be names: ~S" value))
               (setf (getf fields key) (intern (string-upcase (string value)) :keyword)))
             (when (member key '(:independent-cases :normal-differences :normal-groups))
               (unless (member value '(:unknown :declared :supported-by-evidence :contradicted))
                 (error "Unsupported premise state: ~S" value))))
    (make-instance 'aspect :name name :fields (snapshot fields))))

(defun goal (&rest fields) (make-aspect :goal fields))
(defun design (&rest fields) (make-aspect :design fields))
(defun measurements (&rest fields) (make-aspect :measurements fields))
(defun assumptions (&rest fields) (make-aspect :assumptions fields))

(defun revision (object) (%revision object))
(defun proposals (object) (snapshot (%proposals object)))
(defun approvals (object) (snapshot (%approvals object)))
(defun history (object) (snapshot (reverse (%history object))))
(defun aspect-value (object name) (cdr (assoc name (aspects object))))
(defun field (object aspect key) (getf (aspect-value object aspect) key))

(defun record-event (object kind detail)
  (push (list :event kind :revision (revision object) :detail (snapshot detail))
        (%history object)))

(defun invalidate-analysis (object)
  (setf (current-check object) nil (%proposals object) nil)
  (dolist (record (%approvals object))
    (when (eq (getf record :status) :current)
      (setf (getf record :status) :stale))))

(defgeneric configure (object &rest aspects)
  (:documentation "Inspect selected aspects, or atomically apply supplied aspect objects."))

(defun configuration-sheet (object &rest names)
  "Return current values and missing required fields; never prompt or mutate."
  (list :revision (revision object)
        :aspects
        (mapcar (lambda (name)
                  (let ((schema (or (assoc name *aspect-schema*)
                                    (error "Unknown configuration aspect: ~S" name))))
                    (list :aspect name :fields (copy-list (second schema))
                          :current (snapshot (aspect-value object name))
                          :missing (remove-if (lambda (key) (field object name key))
                                              (third schema)))))
                (or names (mapcar #'first *aspect-schema*)))))

(defmethod configure ((object study) &rest selections)
  (cond
    ((every #'keywordp selections) (apply #'configuration-sheet object selections))
    ((every (lambda (item) (typep item 'aspect)) selections)
     (let ((updates (snapshot (aspects object)))
           (names (mapcar #'aspect-name selections)))
       (unless (= (length names) (length (remove-duplicates names)))
         (error "Configure an aspect at most once in a batch."))
       ;; Validate and merge the whole batch before changing the object.
       (dolist (aspect selections)
         (make-aspect (aspect-name aspect) (aspect-fields aspect))
         (let ((entry (assoc (aspect-name aspect) updates)))
           (unless entry
             (setf entry (cons (aspect-name aspect) nil))
             (push entry updates))
           (loop for (key value) on (aspect-fields aspect) by #'cddr
                 do (setf (getf (cdr entry) key) (snapshot value)))))
       (unless (equal updates (aspects object))
         (let ((changes (mapcar
                         (lambda (name)
                           (list :aspect name :before (snapshot (aspect-value object name))
                                 :after (snapshot (cdr (assoc name updates)))))
                         names)))
           (setf (aspects object) updates)
           (incf (%revision object))
           (invalidate-analysis object)
           (record-event object :configured changes)))
       object))
    (t (error "Use aspect names for inspection, or aspect objects for updates; do not mix them."))))

(defun column-index (data name)
  (position name (columns data) :test (lambda (a b) (string-equal (string a) (string b)))))

(defun label= (a b)
  "Symbolic category names in this example's vocabulary are package-independent."
  (if (and (symbolp a) (symbolp b))
      (string= (symbol-name a) (symbol-name b))
      (equal a b)))

(defun finite-real-p (value)
  (and (realp value)
       #+sbcl (not (and (floatp value)
                       (or (sb-ext:float-nan-p value) (sb-ext:float-infinity-p value))))))

(defgeneric check (object &rest aspects)
  (:documentation "Record structural checks and pending obligations at the current revision."))

(defmethod check ((object study) &rest selected)
  (unless (every (lambda (key) (member key '(:data :design :goal :assumptions))) selected)
    (error "Supported check aspects are :data, :design, :goal, and :assumptions."))
  ;; These checks are coupled; selected aspects express the request, all dependencies are assessed.
  (let* ((data (study-data object)) (table (%table data))
         (outcome (column-index data (or (field object :measurements :outcome) :missing)))
         (group (column-index data (or (field object :measurements :group) :missing)))
         (unit (column-index data (or (field object :design :independent-unit) :missing)))
         (technical (column-index data (or (field object :design :replicates-within) :missing)))
         (contrast (field object :goal :contrast))
         (unit-groups (make-hash-table :test 'equal))
         (case-group-counts (make-hash-table :test 'equal))
         (case-group-aliquots (make-hash-table :test 'equal))
         (issues nil) (groups nil) (complete-pairs nil) (duplicates nil))
    (flet ((issue (code message &optional (severity :obligation))
             (push (list :code code :message message :severity severity) issues)))
      (dolist (name (mapcar #'first *aspect-schema*))
        (dolist (key (third (assoc name *aspect-schema*)))
          (unless (field object name key)
            (issue :missing-configuration (format nil "Supply ~S / ~S." name key)))))
      (unless outcome (issue :missing-outcome "The declared response column is absent." :error))
      (unless group (issue :missing-group "The declared group column is absent." :error))
      (unless unit (issue :unknown-independent-unit "Declare a case key present in the source data."))
      (when (and (eq (field object :design :structure) :paired)
                 (not (equal (field object :design :paired-by)
                             (field object :design :independent-unit))))
        (issue :pairing-key "This prototype needs an explicit pair key matching the independent contrast unit."))
      (unless (and (listp contrast) (= 2 (length contrast))
                   (not (label= (first contrast) (second contrast))))
        (issue :unknown-contrast "Supply two distinct group values in explicit difference order."))
      (when (and outcome group unit)
        (dotimes (row (array-dimension table 0))
          (let ((response (aref table row outcome)) (g (aref table row group))
                (u (aref table row unit)))
            (unless (finite-real-p response)
              (issue :nonfinite-response "Mean-contrast prototypes require finite real responses." :error))
            (pushnew g groups :test #'label=)
            (pushnew g (gethash u unit-groups) :test #'label=)
            (incf (gethash (list u g) case-group-counts 0))
            (when technical
              (pushnew (aref table row technical) (gethash (list u g) case-group-aliquots)
                       :test #'equal))))
        (setf duplicates (loop for count being the hash-values of case-group-counts
                               thereis (> count 1)))
        (when (and contrast (= 2 (length contrast)))
          (setf complete-pairs
                (and (= 2 (length groups))
                     (loop for ids being the hash-values of case-group-aliquots
                           always (= 1 (length ids)))
                     (loop for gs being the hash-values of unit-groups
                           always (and (= 2 (length gs))
                                       (every (lambda (g) (member g gs :test #'label=)) contrast)))))
          (unless (every (lambda (g) (member g groups :test #'label=)) contrast)
            (issue :contrast-not-observed "Requested group values are not both present.")))
        (when (and (eq (field object :design :structure) :paired) (not complete-pairs))
          (issue :incomplete-pairs "Require one unambiguous prepared aliquot per case and group; define any missingness or further aggregation policy explicitly."))
        (when (and duplicates (not (eq (field object :measurements :aggregation) :mean)))
          (issue :aggregation-policy "Technical duplicates require an explicit preparation policy."))
        (when (and duplicates (not technical))
          (issue :replicate-structure "Repeated records require a declared technical or other dependence structure."))
        (when (and duplicates
                   (not (equal (field object :design :replicates-within)
                               (field object :design :assignment-unit))))
          (issue :replicate-grouping-policy "This prototype aggregates readings within the declared assignment aliquot."))
        (when (and (eq (field object :design :structure) :independent)
                   (loop for gs being the hash-values of unit-groups thereis (> (length gs) 1)))
          (issue :contradictory-design "A declared independent case occurs in both groups." :error)))
      (when (eq (field object :assumptions :independent-cases) :unknown)
        (issue :independence-premise "Independence is unresolved, not established by identifiers."))
      (when (eq (field object :assumptions :independent-cases) :contradicted)
        (issue :contradicted-independence "The independent-case inference premise is contradicted."))
      (when (eq (field object :assumptions :normal-differences) :contradicted)
        (issue :contradicted-difference-model "The prototype's exact paired-t model is contradicted; no alternative inference justification is implemented."))
      (setf (current-check object)
            (list :revision (revision object) :requested selected
                  :rows (array-dimension table 0) :independent-cases (hash-table-count unit-groups)
                  :two-groups (= 2 (length groups)) :complete-pairs complete-pairs
                  :technical-duplicates duplicates :technical-key-known (not (null technical))
                  :replicate-grouping-compatible
                  (equal (field object :design :replicates-within)
                         (field object :design :assignment-unit))
                  :issues (nreverse issues)))
      (record-event object :checked selected)
      (snapshot (current-check object)))))

(defgeneric propose (object aspect)
  (:documentation "Ask the isolated Wouldwork backend for justified candidate routes."))

(defun proposal-obligations (object method)
  (append
   (mapcar (lambda (issue) (getf issue :code)) (getf (current-check object) :issues))
   (unless (member (field object :assumptions :independent-cases) '(:declared :supported-by-evidence))
     '(:independence-premise))
   (unless (member (field object :assumptions
                          (if (eq method :welch) :normal-groups :normal-differences))
                   '(:declared :supported-by-evidence))
     (list (if (eq method :welch) :sampling-model-assessment :normal-difference-premise)))
   '(:variance-and-sample-size-assessment :scientific-rule-review :numerical-backend-qualification)))

(defgeneric approve (object aspect &key proposal by note)
  (:documentation "Record selection/review of an exact current revision; never establish an assumption."))

(defmethod approve ((object study) aspect &key proposal by note)
  (unless by (error "Approval needs an explicit actor identifier (:by)."))
  (unless (or (assoc aspect *aspect-schema*) (eq aspect :analysis-plan))
    (error "Unknown approval aspect: ~S" aspect))
  (when (and (assoc aspect *aspect-schema*) (not (aspect-value object aspect)))
    (error "Configure ~S before recording its review." aspect))
  (when (eq aspect :analysis-plan)
    (unless (and proposal (find proposal (%proposals object) :key (lambda (p) (getf p :id))))
      (error "Select a current proposal explicitly; approval does not pick the first route.")))
  (push (list :aspect aspect :proposal proposal :by (snapshot by) :note (snapshot note)
              :revision (revision object) :generation (generation object)
              :approved-specification
              (snapshot (if (eq aspect :analysis-plan)
                            (find proposal (%proposals object) :key (lambda (p) (getf p :id)))
                            (aspect-value object aspect)))
              :status :current :meaning :review-or-plan-selection)
        (%approvals object))
  (record-event object :approved (list aspect proposal by))
  object)

(defgeneric report (object)
  (:documentation "Return a local textual proposal report, without publication or numerical execution."))

(defmethod report ((object study))
  (with-output-to-string (out)
    (format out "Study: ~A~%Revision: ~D~%" (study-name object) (revision object))
    (format out "Prototype: suggestions only; statistical rules await scientific review.~%")
    (format out "Goal: ~S~%Design: ~S~%" (aspect-value object :goal) (aspect-value object :design))
    (format out "Measurements: ~S~%Premises: ~S~%"
            (aspect-value object :measurements) (aspect-value object :assumptions))
    (when (current-check object)
      (format out "Measurement rows: ~D; independent case keys: ~D (premise: ~S).~%"
              (getf (current-check object) :rows) (getf (current-check object) :independent-cases)
              (field object :assumptions :independent-cases))
      (dolist (issue (getf (current-check object) :issues))
        (format out "Requirement ~S: ~A~%" (getf issue :code) (getf issue :message))))
    (dolist (proposal (%proposals object))
      (format out "~%Proposal ~S: ~S~%  Rules: ~S~%  Steps: ~{~A~^ -> ~}~%  Obligations: ~S~%"
              (getf proposal :id) (getf proposal :status) (getf proposal :rules)
              (mapcar (lambda (step) (string-downcase (symbol-name (first step))))
                      (getf proposal :steps))
              (getf proposal :obligations)))
    (when (and (find :paired-t (%proposals object) :key (lambda (p) (getf p :id)))
               (find :difference-t (%proposals object) :key (lambda (p) (getf p :id))))
      (format out "~%Comparison: candidate equivalent under identical pairs, contrasts, settings and premises; numerical validation pending. No precision ranking established.~%"))
    (dolist (approval (%approvals object))
      (format out "Approval ~S for ~S by ~S at revision ~D: ~S.~%"
              (getf approval :aspect) (getf approval :proposal) (getf approval :by)
              (getf approval :revision) (getf approval :status)))
    (format out "Search: serial tree enumeration, depth bound 4; absence of a route is not proof of scientific impossibility.~%")))
