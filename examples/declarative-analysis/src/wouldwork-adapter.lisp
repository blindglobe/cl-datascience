(in-package :clds-example)

(defvar *wouldwork-isolated-root* nil
  "Bound by run-grammar.py; never point at the user's active Wouldwork checkout.")

(defvar *planner-diagnostics* nil
  "Enable verbose Wouldwork output for backend debugging, not normal grammar use.")

(defun write-domain (object destination)
  "Translate checked metadata and goals to symbolic Wouldwork relations and rules."
  (let* ((checked (current-check object))
         (paired (and (eq (field object :design :structure) :paired)
                      (field object :design :paired-by)
                      (equal (field object :design :paired-by)
                             (field object :design :independent-unit))))
         (independent (eq (field object :design :structure) :independent))
         (quantity (field object :goal :quantity))
         (facts nil))
    (flet ((fact (name condition) (when condition (push (list name 'experiment) facts))))
      (fact 'continuous-response (eq (field object :measurements :statistical-type) :continuous))
      (fact 'two-groups (getf checked :two-groups))
      (fact 'paired-design paired)
      (fact 'independent-design independent)
      (fact 'complete-pairs (getf checked :complete-pairs))
      (fact 'paired-mean-goal (eq quantity :mean-within-case-difference))
      (fact 'independent-mean-goal (eq quantity :difference-in-population-means))
      (fact 'mean-inference-request (eq (field object :goal :claim) :population-mean-inference))
      (fact 'independence-contradicted (eq (field object :assumptions :independent-cases) :contradicted))
      (fact 'difference-model-contradicted (eq (field object :assumptions :normal-differences) :contradicted))
      (fact 'technical-duplicates (getf checked :technical-duplicates))
      (fact 'aggregation-declared
            (and (eq (field object :measurements :aggregation) :mean)
                 (getf checked :technical-key-known)
                 (getf checked :replicate-grouping-compatible))))
    (let ((*print-case* :downcase) (*print-pretty* t))
      (with-open-file (out destination :direction :output :if-exists :supersede)
        ;; No method-eligibility fact is supplied. Queries derive compatibility.
        (dolist
            (form
             `((in-package :ww)
               (ww-set *problem-name* grammar-study)
               (ww-set *problem-type* planning)
               (ww-set *solution-type* every)
               (ww-set *tree-or-graph* tree)
               (ww-set *depth-cutoff* 4)
               (define-types study (experiment) method (paired-t difference-t welch))
               (define-static-relations
                 (continuous-response study) (two-groups study) (paired-design study)
                 (independent-design study) (complete-pairs study)
                 (paired-mean-goal study) (independent-mean-goal study)
                 (mean-inference-request study) (independence-contradicted study)
                 (difference-model-contradicted study)
                 (technical-duplicates study) (aggregation-declared study))
               (define-dynamic-relations
                 (source-ready study) (unit-values-ready study)
                 (differences-ready study) (proposal-ready study method))
               (define-query paired-mean-compatible? (?s)
                 (and (continuous-response ?s) (two-groups ?s) (paired-design ?s)
                      (complete-pairs ?s) (paired-mean-goal ?s) (mean-inference-request ?s)
                      (not (independence-contradicted ?s)) (not (difference-model-contradicted ?s))))
               (define-query independent-mean-compatible? (?s)
                 (and (continuous-response ?s) (two-groups ?s)
                      (independent-design ?s) (independent-mean-goal ?s)
                      (mean-inference-request ?s) (not (independence-contradicted ?s))))
               (define-query unplanned? (?s)
                 (not (exists (?m method) (proposal-ready ?s ?m))))
               (define-action use-single-readings 1 (?s study)
                 (and (source-ready ?s) (not (technical-duplicates ?s))) (?s)
                 (assert (not (source-ready ?s)) (unit-values-ready ?s)))
               (define-action aggregate-technical-readings 1 (?s study)
                 (and (source-ready ?s) (technical-duplicates ?s) (aggregation-declared ?s)) (?s)
                 (assert (not (source-ready ?s)) (unit-values-ready ?s)))
               (define-action propose-paired-t 1 (?s study)
                 (and (unit-values-ready ?s) (paired-mean-compatible? ?s)
                      (not (differences-ready ?s)) (unplanned? ?s)) (?s)
                 (assert (proposal-ready ?s paired-t)))
               (define-action construct-paired-differences 1 (?s study)
                 (and (unit-values-ready ?s) (paired-mean-compatible? ?s)
                      (not (differences-ready ?s)) (unplanned? ?s)) (?s)
                 (assert (differences-ready ?s)))
               (define-action propose-one-sample-t 1 (?s study)
                 (and (differences-ready ?s) (unplanned? ?s)) (?s)
                 (assert (proposal-ready ?s difference-t)))
               (define-action propose-welch 1 (?s study)
                 (and (unit-values-ready ?s) (independent-mean-compatible? ?s) (unplanned? ?s)) (?s)
                 (assert (proposal-ready ?s welch)))
               (define-init (source-ready experiment) ,@(reverse facts))
               (define-goal (exists (?m method) (proposal-ready experiment ?m)))))
          ;; CLDS and WW symbols are distinct. Print symbolic domain names without
          ;; package qualifiers so the reader interns them in WW's package.
          (let ((*package* (find-package :clds-example)))
            (write form :stream out :escape t)
            (terpri out)))))))

(defun ww-call (name &rest arguments)
  (let ((symbol (find-symbol name "WOULDWORK")))
    (unless (and symbol (fboundp symbol)) (error "Missing Wouldwork operation ~A." name))
    ;; Wouldwork changes *PACKAGE* during solve; keep that inside the backend.
    (let ((*package* (find-package :wouldwork))
          (*standard-output* (if *planner-diagnostics* *standard-output* (make-broadcast-stream)))
          (*trace-output* (if *planner-diagnostics* *trace-output* (make-broadcast-stream))))
      (apply (symbol-function symbol) arguments))))

(defun propose-in-isolated-runtime (object)
  (unless (and *wouldwork-isolated-root*
               (probe-file (merge-pathnames ".clds-isolated-runtime" *wouldwork-isolated-root*))
               (equal (truename *wouldwork-isolated-root*)
                      (truename (asdf:system-source-directory :wouldwork))))
    (error "In-image proposals require an isolated Wouldwork runtime."))
  (check object :data :design :goal :assumptions)
  (setf (%proposals object) nil)
  (incf (generation object))
  (dolist (approval (%approvals object))
    (when (eq (getf approval :aspect) :analysis-plan) (setf (getf approval :status) :stale)))
  (unless (find :error (getf (current-check object) :issues) :key (lambda (i) (getf i :severity)))
    (write-domain object (merge-pathnames "src/problem-grammar-study.lisp" *wouldwork-isolated-root*))
    (ww-call "%STAGE" "grammar-study")
    (ww-call "SOLVE")
    (dolist (solution (symbol-value (find-symbol "*SOLUTIONS*" "WOULDWORK")))
      (let* ((steps (mapcar #'second (ww-call "SOLUTION.PATH" solution)))
             (last-name (symbol-name (first (car (last steps)))))
             (method (cond ((equal last-name "PROPOSE-PAIRED-T") :paired-t)
                           ((equal last-name "PROPOSE-ONE-SAMPLE-T") :difference-t)
                           ((equal last-name "PROPOSE-WELCH") :welch)
                           (t (error "Unrecognized proposal path: ~S" steps)))))
        (push (list :id method :revision (revision object) :generation (generation object)
                    :status :conditional-on-obligations :scientific-review :draft
                    :target (field object :goal :quantity)
                    :goal-contract (snapshot (aspect-value object :goal))
                    :design-contract (snapshot (aspect-value object :design))
                    :premises (snapshot (aspect-value object :assumptions))
                    :rules (append
                            (when (getf (current-check object) :technical-duplicates)
                              '(:R04-technical-aggregation :R05-independent-case-count))
                            (case method
                              (:paired-t '(:R03-paired-design :R09-paired-t-candidate))
                              (:difference-t '(:R03-paired-design :R09-paired-t-candidate :R10-difference-route))
                              (:welch '(:R02-independent-design :R08-welch-candidate))))
                    :steps steps :obligations (remove-duplicates (proposal-obligations object method)))
              (%proposals object)))))
  (unless (%proposals object)
    (push (list :code :no-prototype-route :severity :obligation
                :message "No route was found in this bounded prototype domain. Check goal, design, metadata obligations and scope; this is not a proof that no valid analysis exists.")
          (getf (current-check object) :issues)))
  (record-event object :proposed (mapcar (lambda (p) (getf p :id)) (%proposals object)))
  object)

(defmethod propose ((object study) (aspect (eql :analysis)))
  (if *wouldwork-isolated-root*
      (propose-in-isolated-runtime object)
      (propose-via-worker object)))
