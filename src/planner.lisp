;;;; src/planner.lisp - bridge to the wouldwork planner
;;;;
;;;; FIND-PLANS asks wouldwork for every plan that reaches a goal from a set
;;;; of facts, using a domain file (relations and actions, wouldwork
;;;; syntax). It writes a complete wouldwork problem file, stages it, solves
;;;; it, and returns the minimal plans.
;;;;
;;;; Terms are package-independent: facts, goals and plans are lists of
;;;; symbols compared by name, and plans come back as keyword lists, e.g.
;;;; ((:assume-rows-independent :sleep) (:welch-t-test :extra :group)).
;;;;
;;;; This uses wouldwork internals (%stage, solve, *unique-solutions*,
;;;; solution.path); see AGENTS.md for what staging does to the wouldwork
;;;; installation.

(in-package #:cl-datascience)

(define-condition planning-error (error)
  ((message :initarg :message :reader planning-error-message)
   (output :initarg :output :initform "" :reader planning-error-output))
  (:report (lambda (c stream)
             (format stream "~a" (planning-error-message c))
             (let ((output (string-trim '(#\Space #\Newline) (planning-error-output c))))
               (when (plusp (length output))
                 (format stream "~%--- wouldwork output ---~%~a" output))))))

(defvar *problem-directory*
  (merge-pathnames "cl-datascience-plans/" (uiop:temporary-directory))
  "Where FIND-PLANS writes its wouldwork problem file.")

(defparameter *problem-name* "cldsplan"
  "Name of the generated wouldwork problem (file problem-<name>.lisp).")

;;; Terms

(defun keywordize (form)
  "FORM with every non-NIL symbol replaced by the keyword of the same name."
  (cond ((null form) nil)
        ((symbolp form) (intern (symbol-name form) :keyword))
        ((consp form) (cons (keywordize (car form)) (keywordize (cdr form))))
        (t form)))

(defun term-string (form)
  "FORM printed for a wouldwork problem file: symbols by name, in lower case,
without package prefixes."
  (with-output-to-string (out)
    (labels ((emit (x)
               (cond ((null x) (write-string "nil" out))
                     ((symbolp x) (write-string (string-downcase (symbol-name x)) out))
                     ((consp x)
                      (write-char #\( out)
                      (loop for (item . rest) on x
                            do (emit item)
                               (cond ((consp rest) (write-char #\Space out))
                                     (rest (write-string " . " out) (emit rest))))
                      (write-char #\) out))
                     (t (prin1 x out)))))
      (emit form))))

(defun read-forms (pathname)
  "All forms in PATHNAME, symbols read as keywords, without read-time evaluation."
  (with-open-file (in pathname)
    (let ((*package* (find-package :keyword))
          (*read-eval* nil))
      (loop for form = (read in nil in)
            until (eq form in)
            collect form))))

(defun domain-action-names (domain)
  "Names of the actions defined in the DOMAIN file."
  (loop for form in (read-forms domain)
        when (and (consp form) (eq (first form) :define-action))
          collect (second form)))

;;; Problem file

(defun problem-text (&key objects facts goal domain depth-cutoff)
  "The text of a wouldwork problem file: settings, types (OBJECTS plus a
METHOD type holding every action name of DOMAIN), the DOMAIN text, the
initial FACTS and the GOAL."
  (with-output-to-string (out)
    (format out ";;;; Generated by cl-datascience (src/planner.lisp). Do not edit.~%~%")
    (format out "(in-package :ww)~%~%")
    (format out "(ww-set *problem-name* ~a)~%" *problem-name*)
    (format out "(ww-set *problem-type* planning)~%")
    (format out "(ww-set *solution-type* every)~%")
    (format out "(ww-set *tree-or-graph* graph)~%")
    (format out "(ww-set *depth-cutoff* ~d)~%~%" depth-cutoff)
    (format out "(define-types~%")
    (dolist (entry objects)
      (format out "  ~a ~a~%" (term-string (first entry)) (term-string (rest entry))))
    (format out "  method ~a)~%~%" (term-string (domain-action-names domain)))
    (write-string (uiop:read-file-string domain) out)
    (format out "~%~%(define-init~%~{  ~a~%~})~%~%" (mapcar #'term-string facts))
    (format out "(define-goal~%  ~a)~%" (term-string goal))))

;;; Plans

(defun plan-assumptions (plan)
  "The steps of PLAN that are assumptions: actions named ASSUME-..."
  (remove-if-not (lambda (step)
                   (let ((name (symbol-name (first step))))
                     (and (> (length name) 7) (string= "ASSUME-" name :end2 7))))
                 plan))

(defun step-set-subsetp (a b)
  (subsetp a b :test #'equal))

(defun minimal-plans (plans)
  "PLANS without duplicates and without any plan whose steps include all
steps of another plan (such a plan does something unneeded, e.g. makes an
assumption it does not use). Shortest first, then alphabetically."
  (let* ((unique (remove-duplicates
                  plans :test (lambda (a b) (and (step-set-subsetp a b)
                                                 (step-set-subsetp b a)))))
         (minimal (remove-if (lambda (plan)
                               (some (lambda (other)
                                       (and (not (eq other plan))
                                            (step-set-subsetp other plan)
                                            (not (step-set-subsetp plan other))))
                                     unique))
                             unique)))
    (sort minimal (lambda (a b)
                    (or (< (length a) (length b))
                        (and (= (length a) (length b))
                             (string< (prin1-to-string a) (prin1-to-string b))))))))

(defun solution-plan (solution)
  "The action forms of a wouldwork solution, as keyword lists."
  (mapcar (lambda (entry) (keywordize (second entry)))
          (ww::solution.path solution)))

(defun restore-wouldwork ()
  "Stage wouldwork's own blocks3 problem. Wouldwork compiles its staged
problem every time it is loaded, so a problem that failed to stage must not
stay staged."
  (let ((*standard-output* (make-broadcast-stream))
        (*error-output* (make-broadcast-stream))
        (*trace-output* (make-broadcast-stream))
        (*package* *package*)
        (*readtable* *readtable*))
    (ignore-errors (ww::%stage "blocks3"))))

(defun find-plans (&key objects facts goal domain (depth-cutoff 6))
  "Every minimal plan that reaches GOAL from FACTS.
OBJECTS: list of (type object ...). FACTS: list of propositions. GOAL: a
proposition or (and ...). DOMAIN: pathname of a file with wouldwork
relations, constraints and actions. Returns a list of plans, each a list of
steps such as (:welch-t-test :extra :group); NIL when the goal cannot be
reached. Signals PLANNING-ERROR when wouldwork rejects the problem."
  (let* ((directory (ensure-directories-exist *problem-directory*))
         (file (merge-pathnames (format nil "problem-~a.lisp" *problem-name*) directory))
         (output (make-string-output-stream)))
    (with-open-file (out file :direction :output :if-exists :supersede)
      (write-string (problem-text :objects objects :facts facts :goal goal
                                  :domain domain :depth-cutoff depth-cutoff)
                    out))
    (flet ((fail (message)
             (let ((text (get-output-stream-string output)))
               (restore-wouldwork)
               (error 'planning-error :message message :output text))))
      (handler-case
          (let ((*standard-output* output)
                (*error-output* output)
                (*trace-output* output)
                ;; staging reloads wouldwork, which sets *PACKAGE*
                (*package* *package*)
                (*readtable* *readtable*))
            ;; Staging reloads wouldwork, which resets its folder list.
            (ww:add-problem-folder (namestring directory))
            (unless (ww::%stage *problem-name*)
              (fail "wouldwork could not stage the problem"))
            (ww::solve))
        (planning-error (c) (error c))
        (error (e) (fail (format nil "wouldwork failed: ~a" e)))))
    (minimal-plans (mapcar #'solution-plan ww::*unique-solutions*))))
